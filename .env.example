# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Only needed if using the "claude" live agent. Some orgs also require
# ANTHROPIC_WORKSPACE_ID (see REPRODUCIBILITY.md).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Only needed if using the "gemini" live agent (get a free-tier key at
# aistudio.google.com).
GEMINI_API_KEY=

# "ollama" live agent — zero API key, runs entirely on your machine.
# Install Ollama (ollama.com), run `ollama pull llama3.1` (or another
# tool-calling-capable model), then `ollama serve` if it isn't already
# running as a service. No .env values are required for the defaults below;
# only set these if you're running Ollama somewhere non-default.
# OLLAMA_HOST=http://localhost:11434
# CODEPROOF_OLLAMA_MODEL=llama3.1

# Needed for fetching real GitHub issues via a pasted URL (raises the
# unauthenticated rate limit; works without it for public repos).
GITHUB_TOKEN=

# Needed for the "Connect GitHub" login flow (pick a repo -> pick an issue
# instead of pasting a URL). Register an OAuth App at
# github.com/settings/developers with callback URL
# http://localhost:8000/auth/github/callback, then fill in below.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Any random string — signs the login session cookie. Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET_KEY=

# Optional per-agent turn-budget overrides (default 20/18 depending on
# agent) — raise for large repos, lower to conserve a free-tier quota.
# CODEPROOF_CLAUDE_MAX_TURNS=20
# CODEPROOF_GEMINI_MAX_TURNS=18
# CODEPROOF_OLLAMA_MAX_TURNS=18
